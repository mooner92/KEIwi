# alert-relay 환경변수 **예시** — specs/alert-enrichment §3.3
#
# ⚠️ 이 파일에 실제 값을 쓰지 마라(헌장 §13). 실제 파일은 레포 밖이다:
#     /data/alert-relay/env   (root:root 0600)
#   systemd 유닛이 EnvironmentFile= 로 주입하고, systemd가 **root로 읽은 뒤** 권한을
#   낮춰 프로세스를 띄우므로 서비스 사용자는 이 파일을 읽을 필요조차 없다.
#
# 설치:
#   sudo install -d -m 0750 -o keiwi-relay -g keiwi-relay /data/alert-relay
#   sudo install -m 0600 -o root -g root /dev/null /data/alert-relay/env
#   sudo "$EDITOR" /data/alert-relay/env      # 아래 항목을 실제 값으로
#   sudo systemctl restart keiwi-alert-relay

# ── 필수 ────────────────────────────────────────────────────────────────────
# Grafana webhook contact point 와 공유하는 시크릿.
#   Grafana 쪽: authorization_scheme=Bearer · authorization_credentials=$__env{RELAY_SHARED_SECRET}
#   (Grafana 컨테이너의 /data/monitoring/.env 에 같은 값을 넣는다)
# 생성: openssl rand -hex 32
RELAY_SHARED_SECRET=

# Slack bot token. **기존 알림이 쓰는 것과 같은 토큰**이다(chat.postMessage + thread_ts에
# 추가 스코프가 필요 없다 — 그것이 E3의 전제다). 값은 /data/monitoring/.env 와 동일.
SLACK_BOT_TOKEN=

# ── 섀도 → 컷오버 (spec §3.5) ───────────────────────────────────────────────
# 기본값이 **테스트 채널**이다. 섀도 2주 동안 실채널은 기존 직송이 계속 담당한다.
# 컷오버(T-E3-7)는 이 한 줄을 #keiwi-infra 로 바꾸고 라우팅을 relay로 돌리는 것이다.
RELAY_SLACK_CHANNEL=#keiwi-relay-test

# ── 선택 (기본값이 있다 — 비워두면 기본값) ──────────────────────────────────
# 리슨 주소. 기본 127.0.0.1 — Grafana가 같은 호스트(data05)에 있으므로 외부에 열 이유가 없다.
# 컨테이너 Grafana에서 호스트로 붙어야 하면 172.17.0.1(docker0) 또는 host.docker.internal 경로를
# 확인하고 방화벽을 함께 조인다. 0.0.0.0 은 마지막 수단이다.
# RELAY_LISTEN_ADDR=127.0.0.1
# RELAY_PORT=8130

# Grafana webhook HMAC 서명(선택). 설정하면 공유 시크릿 실패 시 2차 경로로 검증한다.
# ⚠️ 서명 대상 문자열은 [검증 필요] — 섀도 기간에 실제 헤더를 보고 확정한다.
# RELAY_HMAC_SECRET=

# ⚠️ api.slack.com 고정. 이 망은 slack.com 이 SNI 필터로 차단돼 있다(2026-07-30 실측):
#    slack.com/api/api.test → TLS 리셋 / api.slack.com/api/api.test → {"ok":true}
# RELAY_SLACK_API=https://api.slack.com/api

# fingerprint → thread_ts 저장소. 발생→해결을 한 스레드로 묶는 유일한 상태다.
# ⚠️ 이 저장소가 죽어도(디스크 풀·읽기전용) **알림 전달은 멈추지 않는다** — 메모리 티어로
#    계속하고 /healthz 가 degraded 로 알린다. 저장이 게시를 막는 설계였다면 "디스크가 찼다"는
#    알림이 디스크가 차서 못 나가는 자기모순이 된다.
# RELAY_DB=/data/alert-relay/threads.db
# RELAY_TTL_DAYS=30

# 같은 배달을 두 번 게시하지 않는 창(초). Grafana의 **재시도**(응답 지연·5xx 뒤 수십 초)는
# 삼키고, **재통지**(repeat_interval 4h/12h)는 통과시키는 값이어야 한다.
# 0 = 비활성(배달마다 게시 — 수동 반복 테스트용 탈출구).
# RELAY_DEDUP_WINDOW_SEC=300

# Slack 으로 내보낼 수 있는 링크 호스트(쉼표 구분, 포트 포함). 여기 없는 URL은 **삭제**된다 —
# LLM이 지어낸 링크·원문 경로가 URL 모양으로 새는 것을 막는 유일한 수단이다.
# 비우면 기본값: 192.168.1.105:3106(콘솔) · 192.168.1.105:3000(Grafana) · github.com(런북).
# ⚠️ 콘솔·Grafana 주소를 바꾸면 여기도 바꿔라. 안 바꾸면 딥링크가 통째로 사라진다
#    (사라질 때마다 journal 에 `링크 삭제` WARNING 이 남는다).
# RELAY_ALLOWED_URL_HOSTS=192.168.1.105:3106,192.168.1.105:3000,github.com

# 콘솔 어시스턴트(로컬 vLLM). 동시 1요청 계약이라 relay가 직렬 큐로 부른다.
# RELAY_ASSISTANT_URL=http://localhost:3105/api/assistant
# RELAY_ASSISTANT_TIMEOUT=120
# RELAY_RETRIES=3
# RELAY_BACKOFF_BASE=2

# E4 귀속 수집기. 없으면 답글 #1을 **우아하게 생략**한다(E3는 E4 없이도 성립).
# RELAY_COLLECTOR=/opt/keiwi/alert-relay/collectors/disk-attribution.sh
# RELAY_COLLECTOR_TIMEOUT=90

# 보강(답글 #1·#2) 전체 끄기 — 사고 시 1차 전달만 남기는 비상 스위치.
# RELAY_ENRICH=1
# RELAY_LOG_LEVEL=INFO
