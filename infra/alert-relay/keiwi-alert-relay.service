# KEIwi alert-relay — systemd 유닛 (specs/alert-enrichment §3.3 · T-E3-1)
#
# 에이전트 생성, **사람 적용**(헌장 §11). 설치 절차는 infra/alert-relay/README.md.
#   sudo useradd --system --home-dir /data/alert-relay --shell /usr/sbin/nologin keiwi-relay
#   sudo install -d -m 0750 -o keiwi-relay -g keiwi-relay /data/alert-relay
#   sudo install -d -m 0755 /opt/keiwi/alert-relay
#   sudo install -m 0644 infra/alert-relay/alert_relay.py /opt/keiwi/alert-relay/
#   sudo install -m 0644 infra/alert-relay/keiwi_redaction.py /opt/keiwi/alert-relay/   # ← 필수
#   sudo install -m 0644 infra/alert-relay/keiwi-alert-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now keiwi-alert-relay
#   curl -s localhost:8130/healthz | python3 -m json.tool
#
# ⚠️ 컷오버 후에는 이 유닛이 알림 경로다(spec §3.4). Restart=always 와
#    external-watchdog 의 /healthz 감시가 의무다. 롤백은 docs/runbooks/alert-relay-rollback.md.

[Unit]
Description=KEIwi alert-relay (Grafana webhook -> Slack thread + async enrichment)
Documentation=https://github.com/mooner92/KEIwi/blob/main/infra/alert-relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keiwi-relay
Group=keiwi-relay

# 시크릿은 레포 밖(§13). systemd가 **root로** 읽어 주입하므로 서비스 사용자에게
# 읽기 권한을 줄 필요가 없다 — 0600 root:root 를 유지하라.
EnvironmentFile=/data/alert-relay/env
ExecStart=/usr/bin/python3 /opt/keiwi/alert-relay/alert_relay.py

# 컷오버 후 relay 정지 = 알림 정지다. 재기동은 협상 대상이 아니다.
Restart=always
RestartSec=3
# 재기동 폭주 방지 — 5분에 10회를 넘으면 멈추고 watchdog에 맡긴다(조용한 무한 재시작 금지).
StartLimitIntervalSec=300
StartLimitBurst=10

# ── 하드닝 ───────────────────────────────────────────────────────────────────
# 이 서비스는 sqlite 한 개와 아웃바운드 HTTP만 필요하다. 그 밖의 권한은 전부 뺀다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ⚠️ ProtectHome=yes 이므로 E4 수집기의 SSH 자격은 **/data/alert-relay/ 아래**에 둔다
#    (그 편이 "원문은 /data/alert-relay 밖으로 안 나간다"는 §4.1 경계와도 일치한다).
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# sqlite·스냅샷·수집기 산출물이 사는 유일한 쓰기 경로.
ReadWritePaths=/data/alert-relay

# 소형 결정적 중계다. 이 상한을 넘으면 그것 자체가 이상 신호다.
MemoryMax=256M
TasksMax=64

StandardOutput=journal
StandardError=journal
SyslogIdentifier=keiwi-alert-relay

[Install]
WantedBy=multi-user.target
