# KEIwi 모델 카탈로그 수집 타이머 (Ansible 관리 — 대상에서 직접 편집 금지)
# 부팅 후 {{ model_catalog_boot_delay }}, 이후 {{ model_catalog_timer_interval }}마다 수집기 실행.
[Unit]
Description=KEIwi 설치 모델 카탈로그 주기 수집 타이머

[Timer]
OnBootSec={{ model_catalog_boot_delay }}
OnUnitActiveSec={{ model_catalog_timer_interval }}
# 다운타임 동안 놓친 실행은 부팅 직후 한 번 보정.
Persistent=true

[Install]
WantedBy=timers.target
