            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": false,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "scaleDistribution": { "type": "linear" },
