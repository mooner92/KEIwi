      "title": "사용률 추이",
      "transparent": true,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
