          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "VRAM 사용 (MiB)" },
            "properties": [
              { "id": "unit", "value": "mbytes" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.align", "value": "right" },
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "GPU" },
            "properties": [
