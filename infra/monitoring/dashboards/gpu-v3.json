            "matcher": { "id": "byRegexp", "options": ".*GPU [5-9]$" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5A6170" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^data05.*" },
            "properties": [
