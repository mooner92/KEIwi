{
  "uid": "keiwi-gpu-v3",
  "title": "GPU (v3)",
  "description": "KEIwi M2 — 노드 인식 GPU(DCGM). 콘솔 var-instance로 노드 전환. v3 정적 테마(Quiet Console): 게이지 제거·투명 패널·유채색은 임계 초과에만.",
  "tags": ["keiwi", "gpu", "dcgm", "m2", "v3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "10s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "instance",
        "label": "노드 (DCGM endpoint)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(DCGM_FI_DEV_GPU_TEMP, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(DCGM_FI_DEV_GPU_TEMP, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "VRAM 사용률",
      "transparent": true,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#6E7583", "value": null },
              { "color": "#F79009", "value": 75 },
              { "color": "#D92D20", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "text": { "titleSize": 11, "valueSize": 26 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(label_replace(DCGM_FI_DEV_FB_USED{instance=~\"$instance\"} / (DCGM_FI_DEV_FB_USED{instance=~\"$instance\"} + DCGM_FI_DEV_FB_FREE{instance=~\"$instance\"}) * 100, \"node\", \"data04\", \"instance\", \"192\\\\.168\\\\.1\\\\.104:.*\"), \"node\", \"data05\", \"instance\", \"192\\\\.168\\\\.1\\\\.105:.*\")",
          "legendFormat": "{{node}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU 사용률",
      "description": "높은 사용률은 정상(가동 중)이므로 경보색을 쓰지 않는다.",
      "transparent": true,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
