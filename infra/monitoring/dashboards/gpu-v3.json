    {
      "id": 8,
      "type": "table",
      "title": "물리 GPU 인벤토리",
      "description": "물리 GPU 기준. LLM 모델은 '모델' 탭(data05) 참조.",
      "transparent": true,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": { "mode": "thresholds" },
