          "mappings": [],
          "color": { "mode": "fixed", "fixedColor": "#6E7583" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
