{
  "uid": "keiwi-logs",
  "title": "KEIwi 통합 로그",
  "description": "M2 통합 로그 뷰. Filebeat→Logstash→OpenSearch(keiwi-logs-*) 를 Grafana OpenSearch 데이터소스(keiwi-logs-es)로 surface. 변수 node(fleet_node)·category(서비스 범주)·level(log_level) + 시간범위. 에러 우선 패널로 장애 주체(서비스)에 빠르게 도달(spec UL6, ADR-0010). 에이전트 생성·사람 적용(§11). 콘솔 kiosk 임베드.",
  "tags": ["keiwi", "logs", "m2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "서버 (fleet_node)",
        "type": "query",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
        "query": "{\"find\": \"terms\", \"field\": \"fleet_node\"}",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "hide": 0,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "category",
        "label": "범주 (category)",
        "type": "query",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
        "query": "{\"find\": \"terms\", \"field\": \"category\"}",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "hide": 0,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "level",
        "label": "레벨 (log_level)",
        "type": "custom",
        "query": "error,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "hide": 0,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "debug", "value": "debug" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "에러 우선 — 현재 시간범위",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" }, "query": "fleet_node:$node AND category:$category AND log_level:error", "alias": "에러", "metrics": [ { "id": "1", "type": "count" } ], "bucketAggs": [ { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0", "trimEdges": "0" } } ], "timeField": "@timestamp" },
        { "refId": "B", "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" }, "query": "fleet_node:$node AND category:$category AND log_level:warn", "alias": "경고", "metrics": [ { "id": "1", "type": "count" } ], "bucketAggs": [ { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0", "trimEdges": "0" } } ], "timeField": "@timestamp" }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "로그 볼륨 (레벨별)",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } } ] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
          "query": "fleet_node:$node AND category:$category AND log_level:$level",
          "alias": "",
          "metrics": [ { "id": "1", "type": "count" } ],
          "bucketAggs": [
            { "id": "3", "type": "terms", "field": "log_level", "settings": { "min_doc_count": "0", "order": "desc", "orderBy": "_count", "size": "10" } },
            { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0", "trimEdges": "0" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "에러·경고 상위 서비스",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "description": "현재 시간범위에서 error·warn 이 가장 많은 서비스 — 장애 주체 추적(spec UL6).",
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
          "query": "fleet_node:$node AND category:$category AND log_level:(error OR warn)",
          "alias": "",
          "metrics": [ { "id": "1", "type": "count" } ],
          "bucketAggs": [
            { "id": "2", "type": "terms", "field": "service", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_count", "size": "15" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "로그 스트림",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 12 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "keiwi-logs-es" },
          "query": "fleet_node:$node AND category:$category AND log_level:$level",
          "alias": "",
          "metrics": [ { "id": "1", "type": "logs", "settings": { "limit": "500" } } ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ]
    }
  ]
}
