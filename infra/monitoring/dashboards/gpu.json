{
  "uid": "keiwi-gpu",
  "title": "GPU",
  "description": "KEIwi M2 — 노드 인식 GPU(DCGM). 콘솔 var-instance로 노드 전환. 에이전트 생성, 사람 import(§11).",
  "tags": ["keiwi", "gpu", "dcgm", "m2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "10s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "instance",
        "label": "노드 (DCGM endpoint)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(DCGM_FI_DEV_GPU_TEMP, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(DCGM_FI_DEV_GPU_TEMP, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "selected": false,
          "text": "192.168.1.104:9400",
          "value": "192.168.1.104:9400"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "GPU별 VRAM 사용률 (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_FB_USED{instance=\"$instance\"} / (DCGM_FI_DEV_FB_USED{instance=\"$instance\"} + DCGM_FI_DEV_FB_FREE{instance=\"$instance\"}) * 100",
          "legendFormat": "{{modelName}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "GPU 사용률 (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_GPU_UTIL{instance=\"$instance\"}",
          "legendFormat": "{{modelName}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "GPU 온도 (°C)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_GPU_TEMP{instance=\"$instance\"}",
          "legendFormat": "{{modelName}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU 전력 (W)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 250 },
              { "color": "red", "value": 320 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_POWER_USAGE{instance=\"$instance\"}",
          "legendFormat": "{{modelName}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU 사용률 추이 (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_GPU_UTIL{instance=\"$instance\"}",
          "legendFormat": "{{modelName}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "온도 / 전력 추이",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*°C.*" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "custom.axisPlacement", "value": "left" }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*W$" },
            "properties": [
              { "id": "unit", "value": "watt" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_GPU_TEMP{instance=\"$instance\"}",
          "legendFormat": "GPU {{gpu}} °C"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_POWER_USAGE{instance=\"$instance\"}",
          "legendFormat": "GPU {{gpu}} W"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SM 클럭 (MHz)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_SM_CLOCK{instance=\"$instance\"}",
          "legendFormat": "{{modelName}} · GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "GPU별 적재 모델 / 스펙",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "VRAM 사용 (MiB)" },
            "properties": [
              { "id": "unit", "value": "mbytes" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "DCGM_FI_DEV_FB_USED{instance=\"$instance\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Hostname": true,
              "device": true
            },
            "indexByName": {
              "modelName": 0,
              "gpu": 1,
              "Value": 2,
              "UUID": 3
            },
            "renameByName": {
              "modelName": "모델 (modelName)",
              "gpu": "GPU",
              "Value": "VRAM 사용 (MiB)",
              "UUID": "UUID"
            }
          }
        }
      ]
    }
  ]
}
