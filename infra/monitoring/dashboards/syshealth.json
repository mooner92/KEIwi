{
  "uid": "keiwi-syshealth",
  "title": "KEIwi 시스템 건강",
  "description": "디스크 SMART·NVMe 수명·OS 위생(보안패치/재부팅대기/실패 systemd). A1(textfile+systemd)·A2(smartctl) 신규 메트릭 뷰. 메트릭 미수집 시 빈 패널로 안전. 에이전트 생성, 사람 import(§11).",
  "tags": ["keiwi", "syshealth", "smart", "os", "m2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "instance",
        "label": "노드 (node-exporter endpoint)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(node_uname_info, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(node_uname_info, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "한눈에 (플릿 요약)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "SMART 종합 상태 (최저)",
      "description": "smartctl_device_smart_status: 1=정상(PASS), 0=실패(FAIL). 플릿 전 디스크 중 최저값 — 하나라도 실패면 FAIL.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "실패", "color": "red", "index": 0 }, "1": { "text": "정상", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "noValue": "데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["min"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "min(smartctl_device_smart_status)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "재부팅 대기 노드",
      "description": "node_reboot_required(textfile) == 1 인 노드 수. 0 이 정상.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "count(max by (instance) (node_reboot_required) == 1) or vector(0)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "실패 systemd 유닛 (전체)",
      "description": "node_systemd_unit_state{state=\"failed\"} 합. recording rule instance:node_systemd_units_failed:count 의 플릿 합. 0 이 정상.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(instance:node_systemd_units_failed:count) or vector(0)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "미적용 보안 업데이트 (전체)",
      "description": "apt_upgrades_pending(textfile) 중 origin=security 합. origin 라벨이 없으면 값이 비어 보일 수 있음 — 하단 '노드별 미적용 업데이트' 표 참조.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 20 } ] },
          "noValue": "데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(apt_upgrades_pending{origin=~\".*[Ss]ecurity.*\"})" }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "디스크 건강 (SMART · NVMe)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "SMART 종합 상태 (디스크별)",
      "description": "smartctl_device_smart_status. 1=정상, 0=실패. smartctl_exporter 미배포 시 빈 표.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "상태" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "실패", "color": "red", "index": 0 }, "1": { "text": "정상", "color": "green", "index": 1 } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "smartctl_device_smart_status", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true },
            "indexByName": { "instance": 0, "device": 1, "model_name": 2, "serial_number": 3, "Value": 4 },
            "renameByName": { "instance": "노드", "device": "장치", "model_name": "모델", "serial_number": "시리얼", "Value": "상태" }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "NVMe 수명 소모율 (%)",
      "description": "smartctl_device_percentage_used: NVMe 쓰기 수명 소모율(0~100%, 100=수명 도달). SATA/HDD엔 없어 NVMe만 표시.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 } ] },
          "noValue": "NVMe 데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "smartctl_device_percentage_used", "legendFormat": "{{instance}} · {{device}}" }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Reallocated sector 수 (SATA/SAS)",
      "description": "smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\", attribute_value_type=\"raw\"}. 0 초과면 디스크 열화 신호. 지속 증가 시 교체 신호.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "재할당 섹터" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\", attribute_value_type=\"raw\"}", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "attribute_name": true, "attribute_value_type": true, "attribute_id": true, "attribute_flags_short": true, "attribute_flags_long": true },
            "indexByName": { "instance": 0, "device": 1, "Value": 2 },
            "renameByName": { "instance": "노드", "device": "장치", "Value": "재할당 섹터" }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "NVMe 예비 영역 잔량 (available spare %)",
      "description": "smartctl_device_available_spare * 100. 임계치(available_spare_threshold, 보통 10%) 아래로 떨어지면 위험. 값 낮을수록 나쁨.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 20 }, { "color": "green", "value": 50 } ] },
          "noValue": "NVMe 데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "smartctl_device_available_spare * 100", "legendFormat": "{{instance}} · {{device}}" }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "OS 위생 (재부팅 · 보안패치 · systemd)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "재부팅 대기 (노드별)",
      "description": "node_reboot_required(textfile). 1=재부팅 필요(커널/라이브러리 업데이트 후). 0=정상.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "mappings": [ { "type": "value", "options": { "0": { "text": "정상", "color": "green", "index": 0 }, "1": { "text": "재부팅 필요", "color": "red", "index": 1 } } } ]
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "상태" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (instance) (node_reboot_required{instance=~\"$instance\"})", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true },
            "indexByName": { "instance": 0, "Value": 1 },
            "renameByName": { "instance": "노드", "Value": "상태" }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "미적용 업데이트 (노드별)",
      "description": "apt_upgrades_pending(textfile). origin별 대기 패키지 수. origin에 security 포함 여부로 보안 업데이트 식별.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 20 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "대기 수" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "apt_upgrades_pending{instance=~\"$instance\"}", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "arch": true },
            "indexByName": { "instance": 0, "origin": 1, "Value": 2 },
            "renameByName": { "instance": "노드", "origin": "출처(origin)", "Value": "대기 수" }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "실패 systemd 유닛 (목록)",
      "description": "node_systemd_unit_state{state=\"failed\"} == 1. 죽은 서비스 목록. 비어 있으면 정상.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_systemd_unit_state{state=\"failed\", instance=~\"$instance\"} == 1", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "state": true, "type": true, "Value": true },
            "indexByName": { "instance": 0, "name": 1 },
            "renameByName": { "instance": "노드", "name": "유닛" }
          }
        }
      ]
    }
  ]
}
