{
  "__inputs": [
    {
      "name": "DS_KEIWI_LOGS_ES",
      "label": "keiwi-logs-es",
      "description": "M2 통합 로그 OpenSearch(ES 7.10 호환) 데이터소스. UI로 Elasticsearch 데이터소스를 만든 뒤 여기에 매핑한다.",
      "type": "datasource",
      "pluginId": "elasticsearch",
      "pluginName": "Elasticsearch"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "elasticsearch", "name": "Elasticsearch", "version": "1.0.0" },
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ],
  "uid": "keiwi-logs",
  "title": "KEIwi 통합 로그",
  "description": "M2 통합 로그 뷰. Filebeat→Logstash→OpenSearch(keiwi-logs-*) 를 Grafana ES 데이터소스로 surface. 변수 node(fleet_node)·level(log_level) + 시간범위로 검색·필터. 에이전트 생성, 사람 적용(헌장 §11). 콘솔 kiosk 임베드 가능. ※ 임포트 전용본 — 임포트 시 데이터소스를 keiwi-logs-es 로 매핑.",
  "tags": ["keiwi", "logs", "m2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "서버 (fleet_node)",
        "type": "query",
        "datasource": { "type": "elasticsearch", "uid": "${DS_KEIWI_LOGS_ES}" },
        "query": "{\"find\": \"terms\", \"field\": \"fleet_node\"}",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "hide": 0,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "level",
        "label": "레벨 (log_level)",
        "type": "custom",
        "query": "error,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "hide": 0,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "debug", "value": "debug" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "로그 볼륨 (레벨별)",
      "datasource": { "type": "elasticsearch", "uid": "${DS_KEIWI_LOGS_ES}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } } ] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "${DS_KEIWI_LOGS_ES}" },
          "query": "fleet_node:$node AND log_level:$level",
          "alias": "",
          "metrics": [ { "id": "1", "type": "count" } ],
          "bucketAggs": [
            { "id": "3", "type": "terms", "field": "log_level", "settings": { "min_doc_count": "0", "order": "desc", "orderBy": "_count", "size": "10" } },
            { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0", "trimEdges": "0" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "로그 스트림",
      "datasource": { "type": "elasticsearch", "uid": "${DS_KEIWI_LOGS_ES}" },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 7 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "${DS_KEIWI_LOGS_ES}" },
          "query": "fleet_node:$node AND log_level:$level",
          "alias": "",
          "metrics": [ { "id": "1", "type": "logs", "settings": { "limit": "500" } } ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ]
    }
  ]
}
