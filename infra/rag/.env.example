# infra/rag/.env로 복사해 실값을 넣는다 (.env는 비커밋 — PUBLIC 레포 규칙).
# 전 항목 로컬 서비스만 사용 — 외부 API 키 불필요, egress 0.

# vLLM (OpenAI 호환) — 모델 id는 /v1/models 응답의 id 그대로
LLM_BINDING_HOST=http://127.0.0.1:8003/v1
LLM_MODEL=<vllm-model-id>
LLM_BINDING_API_KEY=not_needed

# ollama 임베딩 (bge-m3, dim=1024)
EMBED_HOST=http://127.0.0.1:11434
EMBED_MODEL=bge-m3:latest

# 색인 산출물 위치(레포 밖, 커밋 안 함)
KEIWI_RAG_DIR=~/.local/share/keiwi-rag

# 라이브 vLLM 저부하 접근 — 평시 직렬 1 관례(§12). 색인 배치만 4까지(LightRAG 기본).
LLM_MAX_ASYNC=1

# 색인 규모 노브(선택): 청크가 클수록·gleaning 0일수록 색인 LLM 호출 감소
#RAG_CHUNK_TOKENS=1800
#RAG_CHUNK_OVERLAP=120
#RAG_MAX_GLEANING=0
