# =============================================================================
# KEIwi M2 ELK 스택 — 환경값 "예시" (data05)
# 에이전트 생성, 사람 적용. 실값은 `cp .env.example .env` 후 채움.
# .env 는 커밋 금지(.gitignore 가 .env.* 무시, .example 만 추적). 헌장 §13.
# 이 스택은 시크릿 없음(xpack.security off) — 비번/토큰 placeholder 불필요.
# =============================================================================

# OpenSearch / Logstash 이미지 버전(Docker Hub). 둘 다 받히는 태그로.
OPENSEARCH_VERSION=2.17.1
LOGSTASH_OS_VERSION=8.9.0      # opensearchproject/logstash-oss-with-opensearch-output-plugin 태그

# ── 메모리(보수적) ───────────────────────────────────────────────────────────
# 호스트 RAM 여유에 맞춰 조정. 컨테이너 메모리의 ~50% 이하 권장.
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms512m -Xmx512m

# ── 네트워크 ─────────────────────────────────────────────────────────────────
# Grafana 가 ES 를 컨테이너명(elasticsearch:9200)으로 찾으려면, 기존 모니터링
# 스택(grafana)이 붙은 외부 도커망 이름을 지정한다. 확인:
#   docker inspect grafana --format '{{json .NetworkSettings.Networks}}'
# (예: /data/monitoring 가 디렉터리명 'monitoring' 이면 보통 monitoring_default)
MONITORING_NETWORK=monitoring_default

# Logstash Beats 입력 포트(원격 Filebeat 가 data05:5044 로 전송).
LOGSTASH_BEATS_PORT=5044

# ── Elasticsearch 호스트 노출(검증용) ────────────────────────────────────────
# 기본은 localhost 만 노출(외부 비노출). LAN 검증이 필요하면 0.0.0.0 로(주의: 보안).
ES_HOST_BIND=127.0.0.1
ES_HTTP_PORT=9200
