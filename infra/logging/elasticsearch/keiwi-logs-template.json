{
  "index_patterns": ["keiwi-logs-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "fleet_node": { "type": "keyword" },
        "log_level": { "type": "keyword" },
        "service": { "type": "keyword" },
        "host_name": { "type": "keyword" },
        "message": { "type": "text" }
      }
    }
  },
  "_meta": { "managed-by": "KEIwi M2 (ADR-0008)" }
}
