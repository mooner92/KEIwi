# GlitchTip 시크릿 — 실값은 /data/glitchtip/.env (root:root 0600, 헌장 §13)
# 이 파일은 키 목록만이다. 값을 절대 커밋하지 마라.
#
# 배포 전 반드시 scripts/check-env.sh 로 검증하라 (AC-E-2).
# 빈 시크릿의 비용은 이미 측정됐다: SLACK_BOT_TOKEN 빈 문자열 하나가
# Grafana 전체를 기동 불가로 만들었다(2026-07-30). 같은 실수를 게이트로 막는다.

# openssl rand -hex 32  (64자 hex — check-env.sh가 길이 ≥64를 강제)
SECRET_KEY=

# GlitchTip 전용 PG 컨테이너의 비밀번호 (호스트 PG와 무관)
POSTGRES_PASSWORD=
