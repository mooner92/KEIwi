# Grafana — Overview 임베드용 (iframe src로 브라우저에 노출됨: 내부 ZT URL이라 허용)
GRAFANA_URL=
# 대시보드 경로. 개수 가변 — 여러 개면 쉼표로, 라벨은 '경로|라벨' 형식.
# 경로 = 대시보드 URL의 '/d/' 뒤 부분(uid/slug). 뒤에 ?쿼리(var-*, from/to 등)가 붙어 있어도 됨
# — 콘솔이 kiosk(크롬 숨김)·theme=light를 자동 병합한다(? 중복 걱정 없음).
# 노드 드릴다운(노드 카드 클릭): 시스템 탭=node-exporter(var-instance ip:9100),
#   GPU 탭=DCGM(var-instance ip:9400). 'GPU' 라벨이 붙은 첫 탭에만 DCGM instance를 주입하므로
#   노드별 DCGM 대시보드(uid keiwi-gpu)를 'GPU'로, 모델 워크로드 뷰(uid keiwi-model-workload, data05)는 '모델'로 둔다(ADR-0016).
#   ※ 모델 탭은 repo 프로비저닝 대시보드(keiwi-model-workload)를 쓴다 — UI 수제 대시보드는 컨테이너 재생성 시 소실됨.
#   예) GRAFANA_DASHBOARD_UID=rYdddlPWk/node-exporter-full?...|시스템,keiwi-gpu/gpu?refresh=10s|GPU,keiwi-model-workload/keiwi-model-workload?refresh=10s|모델
GRAFANA_DASHBOARD_UID=

# Grafana — /logs(M2 통합 로그) 임베드용. ELK 로그 대시보드(uid keiwi-logs).
#   예) GRAFANA_LOGS_DASHBOARD_UID=keiwi-logs/logs|통합 로그
GRAFANA_LOGS_DASHBOARD_UID=

# Prometheus — 플릿 상태 질의용 (서버 전용, 브라우저 비노출)
PROMETHEUS_URL=

# 로그 어시스턴트 (M-assistant) — 전부 서버 전용·브라우저 비노출, 외부 egress 0 (온프레미스)
# OpenSearch (로그 검색, 읽기 전용). 예) http://localhost:9200
OPENSEARCH_URL=
# 로컬 vLLM 베이스 URL(OpenAI 호환). 예) http://172.18.0.1:8003
VLLM_URL=
# vLLM이 보고하는 정확한 model id — `curl $VLLM_URL/v1/models` 로 확인(전체 경로일 수 있음).
#   예) /data/vllm/models/Qwen3-Coder-30B-A3B-Instruct-AWQ
VLLM_MODEL=
# 문서 RAG 검색 서비스 (ADR-0026 · infra/rag/rag_service.py — 런북·ADR·스펙 지식그래프).
# **선택**: 미설정이면 문서 근거만 조용히 비활성되고 어시스턴트는 로그(BM25)로 정상 동작한다.
# 로그 검색의 대체가 아니라 보강이다 — 로그 근거 [n], 문서 근거 [D n]으로 번호가 분리된다.
#   예) RAG_URL=http://127.0.0.1:8131
RAG_URL=

# 플릿 인벤토리 경로 (레포 루트 기준 상대경로; cwd = apps/console)
INVENTORY_PATH=../../docs/inventory.yaml

# dev 포트 (라이브 스택과 분리). dev/start 스크립트가 -p 3105로 고정 — 문서용.
PORT=3105

# 에러 트래킹(GlitchTip, ADR-0022) — 미설정이면 SDK 비활성(콘솔 부팅에 무영향).
# DSN은 GlitchTip 프로젝트 생성 후 발급. 실값은 .env.local에만(§13).
GLITCHTIP_DSN=
# 브라우저 이벤트는 콘솔 오리진의 /monitoring 터널 경유(spec §5.1) — E3-8에서 배선.
NEXT_PUBLIC_GLITCHTIP_TUNNEL=/monitoring

# ── 배포 위상 (소스에 박지 않는다 — check:secrets S2, fleet-hardening T5-2·T5-3) ──
# 이 콘솔의 공개 베이스 URL. metadataBase·openGraph.url 에만 쓰이고 브라우저에 노출된다.
# 미설정이면 http://localhost:3105 — env 하나 없이도 build가 성공해야 한다(CI 러너 시크릿 0).
#   예) NEXT_PUBLIC_SITE_URL=https://console.example.com
NEXT_PUBLIC_SITE_URL=

# dev 서버(HMR) 교차 출처 허용 목록. **dev 전용** — 프로덕션 빌드에 영향 없다.
# 127.0.0.1·localhost 는 코드가 항상 더하므로 여기엔 LAN IP·자체 도메인만 쉼표로 적는다.
#
# ⚠️ 사고 이력(next.config.ts 에서 이관): Next 15.2+ 는 dev에서 교차 출처를 막는다.
#    허용되지 않은 호스트로 열면 webpack-hmr WebSocket이 거부되고 **하이드레이션이 통째로
#    죽는다** — SSR HTML은 정상이라 화면은 멀쩡해 보이는데 클릭·토글만 전부 무반응이라
#    원인이 화면에 드러나지 않는다. 실측으로 localhost ✓ / 127.0.0.1 ✗ 로 갈렸다.
#    이 값을 바꾼 뒤에는 정적 검사로 잡히지 않으므로 **격리 worktree + 포트 3199**로 dev를
#    띄워 클릭 반응을 눈으로 확인한다(docs/testing.md). `npm run dev`는 포트가 3105로
#    박혀 있어 라이브 콘솔과 충돌하므로 쓰지 않는다.
#   예) KEIWI_DEV_ORIGINS=192.0.2.10,*.example.com
KEIWI_DEV_ORIGINS=
